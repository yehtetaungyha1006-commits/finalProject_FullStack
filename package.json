{
  "name": "social-final-project",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/local.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node --check api/index.js && node --check server/app.js && node --check server/db.js && node --check server/auth.js && node --check server/schema.js",
    "test:smoke": "node scripts/smoke-test.js",
    "verify": "npm run check && npm run build"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "@vitejs/plugin-vue": "^6.0.1",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "vite": "^7.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
